[Unit]
Description=EnDesk signaling relay
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=endesk
Group=endesk
EnvironmentFile=/etc/endesk/relay.env
WorkingDirectory=/opt/endesk/current/server
ExecStart=/opt/endesk/node/bin/node relay.js
Restart=always
RestartSec=2
# Device-ID ownership lives in /var/lib/endesk (OWNERS_FILE).
StateDirectory=endesk
UMask=0077

NoNewPrivileges=yes
CapabilityBoundingSet=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
MemoryMax=256M
TasksMax=64

[Install]
WantedBy=multi-user.target
