{
  "name": "endesk",
  "productName": "EnDesk",
  "version": "1.0.3",
  "description": "Cross-platform remote desktop (AnyDesk-style) for Windows and macOS. Control one device from another over the network, Windows <-> Mac.",
  "main": "src/main.js",
  "author": "EnDesk",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "relay": "node server/relay.js",
    "postinstall": "electron-builder install-app-deps",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac"
  },
  "dependencies": {
    "@jitsi/robotjs": "0.6.24",
    "electron-updater": "6.8.9",
    "koffi": "2.16.3"
  },
  "devDependencies": {
    "electron": "45.0.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "com.endesk.app",
    "productName": "EnDesk",
    "files": [
      "src/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "**/node_modules/@jitsi/robotjs/**",
      "**/node_modules/koffi/**"
    ],
    "npmRebuild": false,
    "publish": [
      {
        "provider": "generic",
        "url": "https://endesk.enfinito.cloud/downloads/"
      }
    ],
    "extraMetadata": {
      "main": "src/main.js"
    },
    "mac": {
      "category": "public.app-category.utilities",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "universal"
          ]
        }
      ],
      "artifactName": "EnDesk-${version}-mac-${arch}.${ext}",
      "identity": "-",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "x64ArchFiles": "**/node_modules/@jitsi/robotjs/prebuilds/darwin-x64+arm64/*.node",
      "extendInfo": {
        "NSScreenCaptureUsageDescription": "EnDesk shares this screen with a remote device you authorize.",
        "NSAppleEventsUsageDescription": "EnDesk injects keyboard and mouse input to let an authorized remote device control this Mac.",
        "NSMicrophoneUsageDescription": "Not used by EnDesk.",
        "NSCameraUsageDescription": "Not used by EnDesk."
      },
      "files": [
        "!**/node_modules/koffi/**"
      ]
    },
    "dmg": {
      "sign": false
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "files": [
        "!**/node_modules/koffi/build/koffi/{darwin_*,freebsd_*,linux_*,musl_*,openbsd_*,win32_arm64,win32_ia32}/**",
        "!**/node_modules/koffi/{src,vendor,doc}/**",
        "!**/node_modules/koffi/build/koffi/**/*.{exp,lib}"
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "artifactName": "EnDesk-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "EnDesk-Portable-${version}.${ext}"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Utility"
    }
  }
}
